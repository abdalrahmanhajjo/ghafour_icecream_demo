# Copy to .env and fill in
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/ghafour
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES=7d

# Comma-separated list of allowed client origins (Vite dev + prod)
CLIENT_ORIGIN=http://localhost:5173

# Business contact used to build WhatsApp order links (digits only, intl format)
BUSINESS_WHATSAPP=96179167963
BUSINESS_NAME=Ghafour Original 1919

# Seeded admin account (created by `npm run seed`)
ADMIN_EMAIL=admin@ghafour.com
ADMIN_PASSWORD=change-this-password
ADMIN_NAME=Ghafour Admin
